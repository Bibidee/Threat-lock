# ============================================================
# Threat-Lock — root environment template
# Copy to .env and fill real values:  cp .env.example .env
# NEVER commit the real .env (it is gitignored).
# ============================================================

# ---- GenLayer (StudioNet, remote — no Docker) ----
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CHAIN_ID=61999
GENLAYER_NETWORK=studionet
# Operator account private key (fund it from the StudioNet faucet).
# Hex string starting with 0x. Treat like a password.
GENLAYER_PRIVATE_KEY=0xYOUR_OPERATOR_PRIVATE_KEY
# Filled in after we deploy the contract:
THREATLOCK_CONTRACT_ADDRESS=

# ---- Firebase (backend / Admin SDK) ----
# Path to the service-account JSON you download from Firebase console.
FIREBASE_SERVICE_ACCOUNT=firebase/serviceAccountKey.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# ---- Backend (FastAPI) ----
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API (the frontend).
CORS_ORIGINS=http://localhost:3000

# ---- Monitoring thresholds ----
# Threat score (0-100) at/above which we auto-trigger emergency pause.
THREAT_PAUSE_THRESHOLD=75
# How often monitoring workers poll, in seconds.
MONITOR_INTERVAL_SECONDS=30
