# ============================================================
# Threat-Lock — root environment template
# Copy to .env and fill real values:  cp .env.example .env
# NEVER commit the real .env (it is gitignored).
# ============================================================

# ---- GenLayer (StudioNet, remote — no Docker) ----
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CHAIN_ID=61999
GENLAYER_NETWORK=studionet
# Operator account private key (fund it from the StudioNet faucet).
# Hex string starting with 0x. Treat like a password.
GENLAYER_PRIVATE_KEY=0xYOUR_OPERATOR_PRIVATE_KEY
# Filled in after we deploy the contract:
THREATLOCK_CONTRACT_ADDRESS=

# ---- Firebase (backend / Admin SDK) ----
# Path to the service-account JSON you download from Firebase console.
FIREBASE_SERVICE_ACCOUNT=firebase/serviceAccountKey.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# ---- Backend (FastAPI) ----
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API (the frontend).
CORS_ORIGINS=http://localhost:3000

# ---- Monitoring thresholds ----
# Threat score (0-100) at/above which we auto-trigger emergency pause.
THREAT_PAUSE_THRESHOLD=75
# How often monitoring workers poll, in seconds.
MONITOR_INTERVAL_SECONDS=30

# ---- Monitoring workers ----
# Where the monitoring process sends signals (the backend API).
BACKEND_URL=http://localhost:8000
# Optional bearer token the monitor sends to the backend (leave blank in dev).
MONITOR_API_TOKEN=
# Use built-in simulated data sources (true) or real HTTP/RSS sources (false).
MONITOR_SIMULATE=true
# Only push a deterministic threat report when the score is at/above this floor
# (keeps low-level noise off-chain; the contract still auto-freezes at its own
# THREAT_PAUSE_THRESHOLD).
MONITOR_REPORT_FLOOR=40
# Don't re-send an identical signal more often than this many seconds.
MONITOR_COOLDOWN_SECONDS=120

# Volume-spike detector tuning.
VOLUME_WINDOW=20
VOLUME_Z_THRESHOLD=3.0
# Optional real metrics endpoint returning JSON (used when MONITOR_SIMULATE=false).
METRICS_URL=

# News / exploit feed detector.
# Comma-separated RSS/Atom feed URLs (used when MONITOR_SIMULATE=false).
NEWS_FEED_URLS=
# Comma-separated terms that indicate a threat in news/feeds.
WATCHLIST_TERMS=exploit,hack,drain,reentrancy,rug pull,private key,backdoor,vulnerability,stolen
# Comma-separated wallet addresses known to be malicious (auto-flag on interaction).
WALLET_BLACKLIST=
