# Threat-Lock backend env (loaded from repo-root .env). Copy real values into
# ../.env (gitignored). NEVER commit secrets or service-account JSON.

APP_ENV=local
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_API_KEY=

# ---- Firebase (Admin SDK) — inline creds OR a service-account file path ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT=firebase/serviceAccountKey.json

# ---- GenLayer (StudioNet) ----
GENLAYER_MODE=real
GENLAYER_CONTRACT_ADDRESS=
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_PRIVATE_KEY=
GENLAYER_CHAIN_ID=61999
GENLAYER_STUDIONET=true
ADMIN_WALLET_ADDRESS=

# ---- Explorer monitoring (optional; disabled if blank) ----
EXPLORER_PROVIDER=
EXPLORER_API_KEY=
EXPLORER_BASE_URL=
WATCHED_CHAIN=
WATCHED_PROTOCOL_ADDRESS=
WATCHED_TREASURY_ADDRESS=
MONITORED_PROTOCOL_NAME=
MONITORED_PROTOCOL_KEYWORDS=
MONITORED_WALLETS=
SUSPICIOUS_WALLETS=

# ---- News / security feeds (public RSS; no key needed) ----
NEWS_RSS_URLS=
SECURITY_KEYWORDS=hack,exploit,drain,bridge exploit,oracle manipulation,reentrancy,private key compromised,treasury drained,protocol attack,rug,governance attack,flash loan attack
